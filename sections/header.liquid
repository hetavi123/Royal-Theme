{% comment %}
  ============================================================
  sections/site-header.liquid
  FIX: Uses <script defer> instead of script_tag filter
       to resolve ParserBlockingScript theme-check error
  ============================================================
{% endcomment %}

<header class="sh" id="site-header" role="banner">
  <div class="sh__inner">
    {%- comment -%} ── Logo ── {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="sh__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 240 }}"
          alt="{{ section.settings.logo.alt | default: shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        <span class="sh__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} ── Right Actions ── {%- endcomment -%}
    <div class="sh__actions">
      {%- comment -%} Desktop nav links (shown when menu style = inline) {%- endcomment -%}
      {%- if section.settings.nav_style == 'inline' -%}
        <nav class="sh__inline-nav" aria-label="Primary">
          <ul role="list">
            {%- for link in linklists[section.settings.menu].links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="sh__nav-link{% if link.active %} is-active{% endif %}"
                  {% if link.active %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ link.title }}
                  <span class="sh__nav-line" aria-hidden="true"></span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- comment -%} Optional language selector ── {%- endcomment -%}
      {%- if section.settings.show_locale and localization.available_languages.size > 1 -%}
        <div class="sh__locale">
          {%- form 'localization' -%}
            <select
              name="locale_code"
              class="sh__locale-select"
              onchange="this.form.submit()"
              aria-label="Language"
            >
              {%- for lang in localization.available_languages -%}
                <option
                  value="{{ lang.iso_code }}"
                  {% if lang.iso_code == localization.language.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ lang.iso_code | upcase }}
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- comment -%} Cart icon ── {%- endcomment -%}
      {%- if section.settings.show_cart -%}
        <a
          href="{{ routes.cart_url }}"
          class="sh__icon-btn sh__cart"
          aria-label="Cart ({{ cart.item_count }})"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          >
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="sh__badge">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- comment -%} MENU toggle button ── {%- endcomment -%}
      <button
        class="sh__menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="sh-drawer"
        data-sh-toggle
      >
        <span class="sh__menu-label">MENU</span>
        <span class="sh__menu-bars" aria-hidden="true"> <span></span><span></span> </span>
      </button>
    </div>
  </div>

  {%- comment -%} ── Full-screen Drawer Nav ── {%- endcomment -%}
  <div
    class="sh__drawer"
    id="sh-drawer"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Navigation"
  >
    <div class="sh__drawer-inner">
      <button class="sh__drawer-close" aria-label="Close menu" data-sh-toggle>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>

      <nav aria-label="Main navigation">
        <ul class="sh__drawer-list" role="list">
          {%- for link in linklists[section.settings.menu].links -%}
            <li class="sh__drawer-item">
              <a href="{{ link.url }}" class="sh__drawer-link">
                <span class="sh__drawer-num">
                  {%- assign n = forloop.index -%}
                  {{ n | prepend: '0' | slice: -2, 2 }}
                </span>
                <span class="sh__drawer-title">{{ link.title }}</span>
                <span class="sh__drawer-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      {%- if section.settings.drawer_subtext != blank -%}
        <p class="sh__drawer-sub">{{ section.settings.drawer_subtext }}</p>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Site Header",
  "tag": "div",
  "class": "site-header-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "nav_style",
      "label": "Desktop nav style",
      "options": [
        { "value": "drawer", "label": "MENU button only" },
        { "value": "inline", "label": "Inline links + MENU" }
      ],
      "default": "drawer"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_locale",
      "label": "Show language selector",
      "default": false
    },
    {
      "type": "header",
      "content": "Drawer"
    },
    {
      "type": "textarea",
      "id": "drawer_subtext",
      "label": "Drawer bottom text",
      "default": "Always sustainable. Always premium."
    }
  ],
  "presets": [{ "name": "Site Header" }]
}
{% endschema %}
